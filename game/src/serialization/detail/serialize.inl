namespace sft {
//=============================================================================
// Implementations of serialize methods for generic serialization
//=============================================================================

template <detail::IsSimpleSerializable T>
inline void serialize(IWriter& writer, std::string_view name, T const& v) {
  writer.write(name, v);
}

template <wx::detail::HasReflectionMembers T>
void serializeMembers(IWriter& writer, T const& v) {
  auto const& members = wx::detail::getReflectionMembers<T>();

  members.visit([&writer, &v](auto member) {
    using TMember = std::unwrap_ref_decay_t<decltype(member)>;
    if constexpr (TMember::type == wx::MemberType::Field) {
      serialize(writer, member.name(), member.value(&v));
    } else if constexpr (TMember::type == wx::MemberType::Base) {
      auto& baseInst = static_cast<TMember::BaseType const&>(v);
      serializeMembers(writer, baseInst);
    }
  });
}

template <wx::detail::HasReflectionMembers T>
inline void serialize(IWriter& writer, std::string_view name, T const& v) {
  writer.beginObject(name);

  serializeMembers(writer, v);

  writer.endObject();
}

template <class T, class A>
inline void serialize(IWriter& writer, std::string_view name, std::vector<T, A> const& v) {
  writer.beginArray(name, v.size());
  for (auto&& av : v) {
    serialize(writer, "", av);
  }
  writer.endArray();
}

template <class T>
inline void serialize(IWriter& writer, std::string_view name, std::optional<T> const& v) {
  if (v.has_value()) {
    serialize(writer, name, *v);
  }
}
} // namespace sft
