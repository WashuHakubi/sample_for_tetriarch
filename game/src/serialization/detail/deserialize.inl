#pragma once

namespace sft {
//========================================1=====================================
// Implementations of deserialize methods for generic deserialization
//=============================================================================

template <detail::IsSimpleDeserializable T>
void deserialize(IReader& reader, std::string_view name, T& v) {
  reader.read(name, v);
}

template <wx::detail::HasReflectionMembers T>
void deserializeMembers(IReader& reader, T& v) {
  auto const& members = wx::detail::getReflectionMembers<T>();

  members.visit([&reader, &v](auto member) {
    using TMember = std::unwrap_ref_decay_t<decltype(member)>;
    if constexpr (TMember::type == wx::MemberType::Field) {
      deserialize(reader, member.name(), member.value(&v));
    } else if constexpr (TMember::type == wx::MemberType::Base) {
      auto& baseInst = static_cast<TMember::BaseType&>(v);
      deserializeMembers(reader, baseInst);
    }
  });
}

template <wx::detail::HasReflectionMembers T>
void deserialize(IReader& reader, std::string_view name, T& v) {
  reader.beginObject(name);

  deserializeMembers(reader, v);

  reader.endObject();
}

template <class T, class A>
void deserialize(IReader& reader, std::string_view name, std::vector<T, A>& v) {
  size_t count{};
  reader.beginArray(name, count);
  v.resize(count);

  for (auto&& av : v) {
    deserialize(reader, "", av);
  }

  reader.endArray();
}

template <class T>
void deserialize(IReader& reader, std::string_view name, std::optional<T>& v) {
  if (reader.hasKey(name)) {
    v = T{};
    deserialize(reader, name, v.value());
  } else {
    v = std::nullopt;
  }
}
} // namespace sft
